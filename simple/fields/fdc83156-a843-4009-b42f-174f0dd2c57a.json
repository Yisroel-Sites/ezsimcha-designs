[{"id":"71441b62-c8dd-44b4-b3e0-82ce3de1c27b","field_type":"text","label":"בשיר וקול תודה שלוחה וחקוקה, להביע ברכותינו מקרב לב עמוקה, ודין הזמן גרמא בעידן דחדותא, להשתתף בשמחתו בכסא דברכתא, באות הכרת הטוב והוקרה, בשפה נעימה וברורה, ומיטב איחולינו נביעה, בצלצלי שמע ותרועה, למעלת כבוד הרבני הנכבד והנעלה, כביר המעש ופאר המעלה, שמו הטוב נודע בשערים, במעשיו ובפעליו היקרים, מברכים ומשבחים בהדרה, לשם ולתפארה, שכן טוב לבית מדרשינו, ומסור למעננו, בפרט בזמן שמחתינו, להעמיד את סוכתינו, שבחיו אין די למלל, ואין גומרין עליו את ההלל,","default_value":"","style_config":{"color":"#000000","font_size":12,"max_lines":9,"font_style":"normal","text_align":"justify-center","font_family":"FbKtifa","font_weight":"400","line_height":1.2,"letter_spacing":-0.5},"position_config":{"x":207,"y":237,"width":379,"height":112,"z_index":1,"rotation":0},"display_order":0,"role":null},{"id":"98bd317f-d9ad-413f-aadb-7a2bf8cec5ff","field_type":"text","label":"יהי רצון שיעלה הזיווג יפה ברינה, ויזכו לבנות בית נאמן להשראת השכינה, בנוי ומשוכלל בדרכי התורה, ויתמלא ביתם מלא אורה, ויזכו להעמיד דורות ישרים ומבורכים, ויתמשך שרשרת הזהב לנצח נצחים, ולראות בנים ובני בנים בהדרה, עוסקים בתורה ובמצוות לתפארה, הנחת דקדושה והתענוג מהם יעלו על גדותם, ותתקיים הכתוב תפארת בנים אבותם, שילכו בדרכי אבותיהם, להצמיח פירות טובים משרשיהם, לשם לתפארת ולתהלה, בקרב משפחתכם ובקרב עם סגולה, ותזכו לשמחה תמידית באהליכם, ויוסף ה' עליכם ועל בניכם, ולהמשיך במפעליכם היקרים לרוב, כאוות נפשכם הטוב, מתוך רוב סייעתא דשמיא והצלחה, ורב שפע וברכה.","default_value":"","style_config":{"color":"#000000","font_size":12,"max_lines":9,"font_style":"normal","text_align":"justify-center","font_family":"FbKtifa","font_weight":"400","line_height":1.2,"letter_spacing":-0.5},"position_config":{"x":207,"y":794,"width":379,"height":112,"z_index":1,"rotation":0},"display_order":1,"role":null},{"id":"5c00dae5-d624-449c-a8c9-a50cc609147f","field_type":"text","label":"קול צהלה ורנה שפתינו תרננה","default_value":"","style_config":{"color":"#a89078","effects":{"arc_a